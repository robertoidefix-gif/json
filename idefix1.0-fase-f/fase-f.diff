+/* Fase F (F9): estilos de pruebas-corpus.html (style-src 'self': sin estilos en línea). */
+:root {
+  --fondo: #ffffff;
+  --texto: #1d2530;
+  --suave: #5b6675;
+  --borde: #d4dae2;
+  --cabecera: #eef2f6;
+  --peor: #b42318;
+  --mejor: #067647;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --fondo: #12161c;
+    --texto: #e6eaf0;
+    --suave: #a5afbd;
+    --borde: #2c3440;
+    --cabecera: #1b222b;
+    --peor: #ff8a80;
+    --mejor: #7ee2a8;
+  }
+}
+body { margin: 0; background: var(--fondo); color: var(--texto); font: 15px/1.5 system-ui, "Segoe UI", sans-serif; }
+main { max-width: 1200px; margin: 0 auto; padding: 16px; }
+h1 { font-size: 1.5rem; margin: 0.5rem 0; }
+h2 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
+code { font-size: 0.92em; }
+form { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; margin: 1rem 0; }
+button { font: inherit; padding: 0.4rem 0.9rem; border-radius: 6px; border: 1px solid var(--borde); background: var(--cabecera); color: var(--texto); cursor: pointer; }
+button:disabled { opacity: 0.5; cursor: default; }
+#estado { color: var(--suave); }
+table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
+th, td { border: 1px solid var(--borde); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
+th { background: var(--cabecera); }
+td:last-child { overflow-wrap: anywhere; }
+.peor { color: var(--peor); font-weight: 600; }
+.mejor { color: var(--mejor); font-weight: 600; }
+details { margin-top: 2rem; color: var(--suave); }
+@media (max-width: 700px) { table { display: block; overflow-x: auto; } }
