+/**
+ * Fase C (C1): filas de una tabla de Word con su geometría real. gridBefore deja columnas vacías al principio de
+ * la fila, gridSpan hace que una celda ocupe varias columnas (las demás quedan vacías) y vMerge sin «restart»
+ * continúa la celda de arriba: su valor se repite y la celda lleva combinada_desde (la fila de origen), como en
+ * las tablas HTML con rowspan. Antes cada w:tc era una columna y los importes acababan bajo otra cabecera.
+ */
+function docxFilasTabla(tabla, maxColumnas) {
+  const propiedad = (el, contenedor, local) => {
+    const pr = X.hijos(el).find(x => x.local === contenedor);
+    return pr ? X.hijos(pr).find(x => x.local === local) || null : null;
+  };
+  const entero = (el, def) => {
+    const v = Number.parseInt(el ? X.attr(el, "w:val") || "" : "", 10);
+    return Number.isSafeInteger(v) && v > 0 ? Math.min(v, maxColumnas) : def;
+  };
+  const filas = [];
+  const origenes = [];
+  const arriba = []; // por columna: { valor, fila } de la última celda que empezó ahí
+  let combinadas = 0;
+  for (const tr of X.hijos(tabla).filter(x => x.local === "tr")) {
+    const fila = [];
+    const origen = new Map();
+    const antes = propiedad(tr, "trPr", "gridBefore");
+    for (let k = entero(antes, 0); k > 0 && fila.length < maxColumnas; k--) fila.push(null);
+    for (const tc of X.hijos(tr).filter(x => x.local === "tc")) {
+      if (fila.length >= maxColumnas) break;
+      const span = entero(propiedad(tc, "tcPr", "gridSpan"), 1);
+      const vMerge = propiedad(tc, "tcPr", "vMerge");
+      const continua = vMerge !== null && (X.attr(vMerge, "w:val") || "continue") !== "restart";
+      const x = fila.length;
+      if (span > 1 || vMerge !== null) combinadas++;
+      if (continua && arriba[x]) {
+        if (arriba[x].valor !== null) origen.set(x, arriba[x].fila);
+        fila.push(arriba[x].valor);
+      } else {
+        const texto = docxTextoCelda(tc);
+        fila.push(texto === "" ? null : texto);
+        arriba[x] = { valor: texto === "" ? null : texto, fila: filas.length + 1 };
+      }
+      for (let k = 1; k < span && fila.length < maxColumnas; k++) {
+        arriba[fila.length] = { valor: null, fila: filas.length + 1 };
+        fila.push(null);
+      }
+    }
+    filas.push(fila);
+    origenes.push(origen);
+  }
+  return { filas, origenes, combinadas };
+}
