+  let suma = 0;
+  for (let i = 0; i < 256; i++) { total += hist[i]; suma += i * hist[i]; }
+  let sB = 0;
+  let wB = 0;
+  let mejor = -1;
+  let umbral = 128;
+  for (let i = 0; i < 256; i++) {
+    wB += hist[i];
+    const wF = total - wB;
+    if (!wB || !wF) continue;
+    sB += i * hist[i];
+    const v = wB * wF * (sB / wB - (suma - sB) / wF) ** 2;
